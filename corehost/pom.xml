<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.corehost</groupId>
    <artifactId>corehost-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>corehost-api</module>
        <module>corehost-proxy</module>
        <module>corehost-lobby</module>
        <module>corehost-game</module>
        <module>corehost-sumo</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <cloudnet.version>4.0.0-RC16</cloudnet.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>infernalsuite-snapshots</id>
            <url>https://repo.infernalsuite.com/repository/maven-snapshots/</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
        <repository>
            <id>cloudnet-repository</id>
            <url>https://repository.cloudnetservice.eu/</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- CloudNet BOM -->
            <dependency>
                <groupId>eu.cloudnetservice.cloudnet</groupId>
                <artifactId>bom</artifactId>
                <version>${cloudnet.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>eu.cloudnetservice.cloudnet</groupId>
                <artifactId>driver-api</artifactId>
                <version>${cloudnet.version}</version>
            </dependency>
            
            <!-- Gson -->
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>2.10.1</version>
            </dependency>
            
            <!-- Velocity API -->
            <dependency>
                <groupId>com.velocitypowered</groupId>
                <artifactId>velocity-api</artifactId>
                <version>4.0.0</version>
                <scope>provided</scope>
            </dependency>

            <!-- Paper API -->
            <dependency>
                <groupId>io.papermc.paper</groupId>
                <artifactId>paper-api</artifactId>
                <version>26.2-rc-2.build.9-alpha</version>
                <scope>provided</scope>
            </dependency>

            <!-- AdvancedSlimePaper API -->
            <dependency>
                <groupId>com.infernalsuite.asp</groupId>
                <artifactId>api</artifactId>
                <version>4.0.0-SNAPSHOT</version>
                <scope>provided</scope>
            </dependency>
            
            <!-- Redis (Jedis) -->
            <dependency>
                <groupId>redis.clients</groupId>
                <artifactId>jedis</artifactId>
                <version>8.0.0-beta1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
